rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWhitelistedAdminEmail() {
      return isSignedIn() 
        && request.auth.token.email != null 
        && (
          request.auth.token.email.lower() == '123.aarushsharma@gmail.com' || 
          request.auth.token.email.lower() == 'asji.online@gmail.com'
        );
    }

    function isAdmin() {
      return isSignedIn() 
        && (
          (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
          || isWhitelistedAdminEmail()
        );
    }

    function is12DigitUTR(utr) {
      return utr is string && utr.matches('^[0-9]{12}$');
    }

    // 1. Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Admins collection - Read by owner or admin, writeable by whitelisted master admin
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isOwner(adminId) && isWhitelistedAdminEmail();
    }

    // 3. Admin Activity Audit Logs - Write-only for admins, no client read/delete
    match /auditLogs/{logId} {
      allow create: if isAdmin() 
        && request.resource.data.adminUid == request.auth.uid 
        && request.resource.data.action is string 
        && request.resource.data.timestamp is timestamp;
      allow read, update, delete: if false;
    }

    // 4. User Isolated Data & Vault
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /audits/{auditId} {
        allow read, write: if isOwner(userId);
      }

      match /notices/{noticeId} {
        allow read, write: if isOwner(userId);
      }

      match /consents/{consentId} {
        allow create, read: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }

      match /chat_sessions/{sessionId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // 5. Rate Limit Tracker per User
    match /scan_rate_limits/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 6. Global Verified World Sovereign Laws Database (Public Read)
    match /laws/{lawId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Payment Verification Transactions / UTR Requests
    match /transactions/{txnId} {
      // Users can create only their own payment request
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.domain is string
        && request.resource.data.domain.size() <= 253
        && is12DigitUTR(request.resource.data.referenceId);
      // Only admins can read/update/approve/reject transactions
      allow read, update, delete: if isAdmin();
    }

    // 8. Active Domain Licenses (Public Read for Active License Lookup, Write for Admin)
    match /licenses/{domain} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Test connection ping
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
