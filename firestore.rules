rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Hardened Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "123.aarushsharma@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 2. Public Verified World Sovereign Laws Database
    match /laws/{lawId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. User Isolated Private Documents & Vault
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Private User Audits History
      match /audits/{auditId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Private User Statutory Notices & Charters
      match /notices/{noticeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Private User Chat Sessions with Oracle
      match /chat_sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();

        match /messages/{messageId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // 4. Backward Compatibility for Legacy Public Demo Chat Sessions
    match /chat_sessions/{sessionId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 5. Admin Directory
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.masterPasscode == "ASJI-CITADEL-2026" ||
        request.auth.token.email == "123.aarushsharma@gmail.com"
      );
      allow update, delete: if isAdmin();
    }

    // 6. Enterprise Licensing & Payment Verification Transactions
    match /transactions/{txnId} {
      // Anyone can submit a payment verification reference
      allow create: if request.resource.data.referenceId is string &&
                       request.resource.data.domain is string;
      // Reading, verifying and updating transactions strictly restricted to admin
      allow read, update, delete: if isAdmin();
    }

    // 7. Active Licensed Domains (verified by admin)
    match /licenses/{domain} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Test connection ping
    match /test/{testId} {
      allow read, write: if true;
    }

    // 9. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
